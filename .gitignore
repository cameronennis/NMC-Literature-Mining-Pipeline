# ---------------------------------------------------------------------------
# Local, heavy, and generated files -- kept on your machine, never in the repo.
# Everything you don't want to track lives in ONE folder, so the repo stays
# small and clean: the paper PDFs, test runs, debug traces, data findings, and
# old versions of the tool. Move anything else you want to keep-but-not-commit
# into that folder and it's handled automatically.
# ---------------------------------------------------------------------------
Local Files (not in repo)/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments & caches
.venv/
venv/
.pytest_cache/

# Tool run outputs (regenerated) -- in case you point --out-dir inside the repo
figures/
contracts/
traces/
compiled/
*_manifest.json
batch_summary.json

# macOS / editor
.DS_Store

# Claude Code local (machine-specific) settings -- never shared
**/settings.local.json
